# Marks every Lombok-generated member with @lombok.Generated, which JaCoCo recognises and
# excludes from coverage automatically.
#
# Without this, the ~58,000 instructions of generated getters, setters, equals, hashCode and
# toString across domain/model dominate the coverage figure, and an 80% gate could only be met by
# writing tests that assert setX/getX round-trips. That is coverage theatre: it moves the number
# without testing anything. Filtering generated code means the percentage reflects hand-written
# logic only, which is the thing worth gating on.
lombok.addLombokGeneratedAnnotation = true
config.stopBubbling = true
