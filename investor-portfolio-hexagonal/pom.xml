<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>

  <groupId>com.hexagonal</groupId>
  <artifactId>investor-portfolio-hexagonal</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>investor-portfolio-hexagonal</name>
  <description>Investor portfolio read model in Hexagonal (Ports and Adapters) Architecture</description>

  <properties>
    <!--
          Java 17 retained. template-microservice uses 21, but nothing here needs a 21-only
          feature and the toolchain on this machine is 17. Aligning is a team decision with a
          real cost (CI images, deploy targets), not a build-config tweak — see the standards
          review, section 5.
        -->
    <java.version>17</java.version>

    <checkstyle.plugin.version>3.3.1</checkstyle.plugin.version>
    <checkstyle.version>10.17.0</checkstyle.version>
    <pmd.plugin.version>3.22.0</pmd.plugin.version>
    <spotbugs.plugin.version>4.8.5.0</spotbugs.plugin.version>
    <spotless.plugin.version>2.43.0</spotless.plugin.version>
    <jacoco.version>0.8.12</jacoco.version>
    <errorprone.version>2.28.0</errorprone.version>
    <nullaway.version>0.10.26</nullaway.version>
    <dependency.check.version>9.2.0</dependency.check.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.32</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.3.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Architecture fitness test: fails the build when the hexagonal
             dependency rule is violated. See HexagonalArchitectureTest. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.3.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
              Error Prone + NullAway, running at WARNING severity.

              Warnings rather than errors is the ratchet for compile-time analysis: NullAway on
              4,700 lines of ported valuation code reports every unchecked dereference, and none
              of that can be fixed without touching arithmetic that is not yet under test.
              Findings are visible on every build; promote to ERROR per-check as areas are
              cleaned up, starting with the packages that now have coverage.

              annotationProcessorPaths replaces the classpath processor discovery, so Lombok is
              re-declared here — omitting it silently disables every @Data and @Slf4j in the
              build.
            -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <showWarnings>true</showWarnings>
          <!--
                      Error Prone needs javac's internal APIs opened to it. The -J flags below
                      only reach javac when it runs in its own JVM, so the compiler must be
                      forked; without this, compilation dies with IllegalAccessError on
                      com.sun.tools.javac.api.
                    -->
          <fork>true</fork>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- Must stay on one line: newlines here become separate javac flags. -->
            <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -XepExcludedPaths:.*/target/generated-sources/.* -Xep:NullAway:WARN -XepOpt:NullAway:AnnotatedPackages=com.hexagonal.portfolio</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>1.18.32</version>
            </path>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
              Checkstyle: project ruleset, enforced at zero violations.

              Not google_checks — that reports 13,888 violations here, 96% of which are the
              ported layout and the deliberate snake_case DB field names. config/checkstyle/
              records which checks are omitted and why.
            -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.plugin.version}</version>
        <configuration>
          <configLocation>config/checkstyle/checkstyle.xml</configLocation>
          <propertyExpansion>checkstyle.suppressions.file=${project.basedir}/config/checkstyle/suppressions.xml</propertyExpansion>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
          <consoleOutput>true</consoleOutput>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>checkstyle</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!--
              PMD + CPD. maven-pmd-plugin's excludeFromFailureFile is the ratchet: every
              violation present today is listed in config/pmd/pmd-baseline.txt, so the build
              passes now and any NEW violation fails it. Shrink that file as classes are
              cleaned up; never add to it without a reason.
            -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>${project.basedir}/config/pmd/ruleset.xml</ruleset>
          </rulesets>
          <excludeFromFailureFile>${project.basedir}/config/pmd/pmd-baseline.txt</excludeFromFailureFile>
          <failOnViolation>true</failOnViolation>
          <printFailingErrors>true</printFailingErrors>
          <includeTests>false</includeTests>
          <analysisCache>true</analysisCache>
          <minimumTokens>120</minimumTokens>
        </configuration>
        <executions>
          <execution>
            <id>pmd</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!--
              SpotBugs. Bytecode analysis, so it sees Lombok output as ordinary code —
              config/spotbugs/exclude.xml scopes those away. Threshold starts at High and
              tightens as findings are burned down.
            -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>High</threshold>
          <excludeFilterFile>${project.basedir}/config/spotbugs/exclude.xml</excludeFilterFile>
          <failOnError>true</failOnError>
          <includeTests>false</includeTests>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!--
              Spotless, ratcheted to HEAD: only files changed from this commit onward are
              checked, so the ported source keeps its legacy-diffable layout.

              google-java-format is deliberately NOT enabled. Under a ratchet it would still
              reflow every file anyone touches, and the first touch would land on
              InvestorPortfolioService — exactly the file whose line-for-line diff against the
              legacy service is worth most. The steps below cannot move a statement: they
              normalise imports and whitespace only. Promote to a real formatter once the
              response-diff has been run and the legacy source is no longer the reference.
            -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.plugin.version}</version>
        <configuration>
          <ratchetFrom>HEAD</ratchetFrom>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,jakarta,org,com,</order>
            </importOrder>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>test</phase>
          </execution>

          <!--
                      Coverage floor. The agreed target is 80% instruction coverage on application
                      and domain; these limits are a ratchet set just under what is currently
                      achieved, so the build fails on regression today and the numbers are raised as
                      the remaining tests land.

                      The gap to 80% is almost entirely two classes: InvestorPortfolioService
                      (13,653 uncovered instructions) and InvestorTaxReportService (4,254). Together
                      they are ~82% of everything still uncovered in this scope. Raise the bundle
                      limit to 0.80 once those are tested; nothing else stands in the way.

                      Lombok-generated members are excluded automatically via lombok.config
                      (addLombokGeneratedAnnotation), so these percentages describe hand-written
                      code rather than generated accessors.
                    -->
          <execution>
            <id>check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <!-- TARGET: 0.80 -->
                      <minimum>0.20</minimum>
                    </limit>
                  </limits>
                </rule>
                <!--
                                  The 80% instruction gate, applied to every application/domain
                                  package that currently meets it. These are hard gates, not
                                  ratchets: dropping below 80% here fails the build.

                                  com.hexagonal.portfolio.application.service is the one package
                                  in scope not listed, at 11.5% — its two large services are
                                  still untested. Add it here once they are.
                                -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.hexagonal.portfolio.domain.service</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.hexagonal.portfolio.domain.exception</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.hexagonal.portfolio.adapter.in.web</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
          OWASP Dependency-Check.

          Deliberately behind a profile rather than bound to the default build. The plugin
          downloads and maintains a local copy of the NVD; the first run takes several minutes,
          it needs network access, and current versions are rate-limited without an NVD API key.
          Binding it to `verify` would make every ordinary build slow and make offline builds
          fail — so it runs where that cost belongs: nightly, or in a dedicated CI job.

              mvn verify -Psecurity -Dnvd.api.key=YOUR_KEY

          CVSS 7 and above fails the build. Register a key at
          https://nvd.nist.gov/developers/request-an-api-key
        -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency.check.version}</version>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${nvd.api.key}</nvdApiKey>
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
