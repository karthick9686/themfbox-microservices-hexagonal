# TEMPLATE ONLY — this file is committed to git. Never put real values here.
#
# Copy it, then edit the copy:
#
#     cp .env.example .env
#
# .env is gitignored; .env.example is not. Anything written below is published.
#
# ---------------------------------------------------------------------------
# ROTATE BEFORE USE
#
# The values that used to sit in application-dev.properties and application-prod.properties
# were committed to a PUBLIC GitHub repository and remain readable in git history even now
# that the files no longer contain them. Treat all of them as compromised:
#
#   - the mfportfolio database user
#   - the advisorkhoj_amfi database user
#   - the shared jwt.secret-key (unused by this service, but likely shared with auth-service)
#
# Removing them from the working tree does not unpublish them. Rotation at the database and
# a history rewrite are both still required.
# ---------------------------------------------------------------------------

# Primary datasource — mfportfolio
DB_PRIMARY_URL=jdbc:mysql://HOST:3306/mfportfolio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_PRIMARY_USERNAME=
DB_PRIMARY_PASSWORD=

# Secondary datasource — advisorkhoj_amfi
DB_SECONDARY_URL=jdbc:mysql://HOST:3306/advisorkhoj_amfi?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_SECONDARY_USERNAME=
DB_SECONDARY_PASSWORD=

# Optional — defaults are in the profile properties
# SERVER_PORT=8099
# SERVER_BASE_URL=http://localhost:8099
# AMC_LOGO_URL=https://api.advisorkhoj.com/nse/images/amc-logo/
